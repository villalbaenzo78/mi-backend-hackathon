# Copia este archivo como .env y completá tus claves.
# Clave gratuita de Groq (rápida, recomendada): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Clave gratuita de NVIDIA NIM (se usa para visión de imágenes): https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
PORT=3000
